#!/bin/bash
# Запускает локальную версию сайта БумБастик и открывает её в браузере.
# Запуск: двойной клик по файлу в Finder.

cd "$(dirname "$0")" || exit 1

echo ""
echo "  ╔════════════════════════════════════════╗"
echo "  ║   БумБастик — локальный сайт           ║"
echo "  ╚════════════════════════════════════════╝"
echo ""

# --- Проверка, что Node.js установлен ---
if ! command -v npm >/dev/null 2>&1; then
  echo "  ❌ Не найден Node.js."
  echo "     Скачайте и установите с https://nodejs.org (версия LTS)."
  echo ""
  read -n 1 -s -r -p "  Нажмите любую клавишу, чтобы закрыть..."
  exit 1
fi

# --- Проверка зависимостей ---
if [ ! -d "node_modules" ]; then
  echo "  📦 Первый запуск — устанавливаю зависимости, это займёт минуту..."
  echo ""
  npm install || { echo ""; echo "  ❌ Не удалось установить зависимости."; read -n 1 -s -r -p "  Нажмите любую клавишу..."; exit 1; }
  echo ""
fi

# --- Освобождаем порт, если сайт уже был запущен ---
if lsof -ti tcp:5173 >/dev/null 2>&1; then
  echo "  ♻️  Сайт уже был запущен — перезапускаю..."
  lsof -ti tcp:5173 | xargs kill -9 >/dev/null 2>&1
  sleep 1
fi

# --- Открываем браузер через 3 секунды, когда сервер поднимется ---
( sleep 3; open "http://localhost:5173/" ) &

echo "  ✅ Запускаю сайт..."
echo "     Браузер откроется сам через пару секунд."
echo ""
echo "  ────────────────────────────────────────────"
echo "  Правьте .md файлы — страница обновится сама."
echo "  Чтобы остановить: закройте это окно или Ctrl+C"
echo "  ────────────────────────────────────────────"
echo ""

npm run docs:dev

echo ""
echo "  Сайт остановлен."
read -n 1 -s -r -p "  Нажмите любую клавишу, чтобы закрыть окно..."
